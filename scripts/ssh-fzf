#!/usr/bin/env bash
# Parses your ssh config with includes (1-level only)
# and connects to whichever host you picked via fzf.

BASE_SSH_CONFIG="$HOME/.ssh/config"

get_included_configs() {
  awk 'tolower($1) == "include" { for (i = 2; i <= NF; i++) print $i }' "$BASE_SSH_CONFIG" | sed "s|^~|$HOME|"
}

connect() {
  ssh "$1"
}

connect_fuzzy() {
  INCLUDED_CONFIGS=$(get_included_configs)

  HOSTS=$(grep -h "^\s*Host " "$BASE_SSH_CONFIG" $INCLUDED_CONFIGS)
  SELECTION=$(echo "$HOSTS" | awk '{ for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' | fzf --height 40% --layout reverse --border)

  if [ -n "$SELECTION" ]; then
    connect "$SELECTION"
  else
    echo no host selected.
  fi
}

if [[ -n $1 ]]; then
  connect "$1"
else
  connect_fuzzy
fi
