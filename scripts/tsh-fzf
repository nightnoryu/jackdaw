#!/usr/bin/env bash
# Parses your `tsh ls` output and connects
# to whichever host you picked via fzf.

connect() {
  tsh ssh "$1"
}

connect_fuzzy() {
  HOSTS=$(tsh ls -f names)
  SELECTION=$(echo "$HOSTS" | fzf --height 40% --layout reverse --border)

  if [ -n "$SELECTION" ]; then
    connect "$SELECTION"
  else
    echo no host selected.
  fi
}

if [[ -n $1 ]]; then
  connect "$1"
else
  connect_fuzzy
fi
