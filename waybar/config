{
  "layer": "bot",
  "margin-bottom": 0,
  "margin-top": 0,
  "position": "top",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "battery",
    "clock"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "tooltip": false
  },
  "tray": {
    "spacing": 6
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}",
    "interval": 30,
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "iso8601": true,
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#dadbd1'><b>{}</b></span>",
        "days": "<span color='#a6bb8c'><b>{}</b></span>",
        "weeks": "<span color='#bea184'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "network": {
    "format": " {bandwidthDownBits}",
    "format-disconnected": "󰤮 No Network",
    "interval": 30,
    "tooltip": false,
    "on-click": "kitty -e nmtui"
  },
  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 100,
    "format": " {volume}%",
    "nospacing": 1,
    "format-muted": " 0%",
    "on-click": "pavucontrol",
    "tooltip": false
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""]
  }
}
